#!/bin/bash

if [ ! -d ".venv" ]; then
    echo "Virtual environment not found. Initializing..."
    ./jack-in.sh
fi

source .venv/bin/activate

if [ "$1" == "--setup" ] || [ "$1" == "-setup" ]; then
    python src/setup_wizard.py
elif [ "$1" == "--model" ] || [ "$1" == "-model" ]; then
    if [ -z "$2" ]; then
        echo "Usage: ./jack -model <model_name>"
        exit 1
    fi
    if grep -q "LITELLM_MODEL_NAME=" .env; then
        sed -i.bak "s|^LITELLM_MODEL_NAME=.*|LITELLM_MODEL_NAME=$2|" .env && rm -f .env.bak
    else
        echo "LITELLM_MODEL_NAME=$2" >> .env
    fi
    echo "[+] Switched neural model to: $2"
elif [ "$1" == "--viewer" ]; then
    python src/viewer.py
elif [ "$1" == "--gateway" ]; then
    uvicorn src.api:app --reload
else
    python src/main.py
fi
